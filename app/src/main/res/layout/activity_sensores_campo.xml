<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainSensoresCampo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO CON LOGO -->
        <LinearLayout
            android:id="@+id/layoutHeaderSensores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/ivLogoSensores"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:contentDescription="@string/desc_logo_empresa"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloSensores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_sensores_campo"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtituloSensores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitulo_sensores_campo"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- TARJETA 1: NIVELACIÓN DE MÁSTIL / CPE (CAMBIA DE COLOR DINÁMICAMENTE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNivelMastil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/sensor_fondo_tarjeta"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/sensor_borde_neutro"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_nivel_titulo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_nivel_subtitulo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValorInclinacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/valor_inclinacion_inicial"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBadgeEstadoNivel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/sensor_ok_fondo"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/estado_nivel_esperando"
                    android:textColor="@color/sensor_ok_texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA 2: BRÚJULA / AZIMUT DE ALINEACIÓN -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBrujulaEnlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/sensor_fondo_tarjeta"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/sensor_borde_neutro"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/card_brujula_titulo"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/card_brujula_subtitulo"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvValorAzimut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/valor_azimut_inicial"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEstadoBrujula"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/sensor_ok_fondo"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/estado_brujula_activa"
                    android:textColor="@color/sensor_ok_texto"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TELEMETRÍA COMPACTA DE EJES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/seccion_detalle_tecnico"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTelemetriaEjes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp" />

        <!-- BOTONES DE ACCIÓN -->
        <Button
            android:id="@+id/btnToggleSensores"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:maxLines="1"
            android:text="@string/btn_pausar_sensores" />

        <Button
            android:id="@+id/btnVolverPanelSensores"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:maxLines="1"
            android:text="@string/btn_volver_panel_sensores" />

    </LinearLayout>
</ScrollView>